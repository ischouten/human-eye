{
  "name": "agent-context-monorepo",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @agent-context/core build",
    "build:vscode": "pnpm --filter @agent-context/vscode build",
    "build:browser": "pnpm --filter @agent-context/browser build",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
