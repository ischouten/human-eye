{
  "name": "human-eye",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "corepack pnpm -r build",
    "build:core": "corepack pnpm --filter @agent-context/core build",
    "build:vscode": "corepack pnpm --filter human-eye... build",
    "build:browser": "corepack pnpm --filter @agent-context/browser... build",
    "clean": "corepack pnpm -r clean",
    "typecheck": "corepack pnpm build:core && corepack pnpm -r typecheck",
    "test": "corepack pnpm build:core && node --test packages/core/test/*.test.mjs",
    "package:vscode": "corepack pnpm build:vscode && corepack pnpm --filter human-eye package"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
