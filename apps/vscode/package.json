{
  "name": "human-eye",
  "displayName": "HumanEye",
  "description": "Make code human-readable by folding @agent-context maintenance annotations.",
  "version": "0.1.38",
  "private": true,
  "publisher": "ischouten",
  "repository": {
    "type": "git",
    "url": "https://github.com/ischouten/human-eye.git",
    "directory": "apps/vscode"
  },
  "homepage": "https://github.com/ischouten/human-eye#readme",
  "bugs": {
    "url": "https://github.com/ischouten/human-eye/issues"
  },
  "icon": "images/human-eye.png",
  "type": "commonjs",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "agent-context",
    "ai",
    "ai comments",
    "ai-slop",
    "aislop",
    "aislob",
    "cleanup",
    "comments",
    "folding",
    "maintainability",
    "readability"
  ],
  "scripts": {
    "build": "esbuild src/extension.ts src/presentation.ts src/instructions.ts --bundle --platform=node --format=cjs --outdir=dist --external:vscode --sourcemap",
    "vscode:prepublish": "npm run build",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test test/*.test.cjs",
    "test:integration": "npm run build && node test/integration/run.cjs",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@agent-context/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.3-12",
    "esbuild": "^0.25.9",
    "mocha": "11.7.2"
  },
  "license": "SEE LICENSE IN LICENSE",
  "contributes": {
    "commands": [
      {
        "command": "agentContext.installFoldingControlStyle",
        "title": "Install Folding Control Hover Style",
        "category": "HumanEye"
      },
      {
        "command": "agentContext.selectVisibleTypes",
        "title": "Select Visible Annotation Types",
        "category": "HumanEye"
      },
      {
        "command": "agentContext.installAgentInstructions",
        "title": "Install Agent Instructions",
        "category": "HumanEye"
      }
    ],
    "configurationDefaults": {
      "editor.foldingHighlight": false
    },
    "configuration": {
      "title": "HumanEye",
      "properties": {
        "agentContext.visibility": {
          "type": "string",
          "enum": [
            "hidden",
            "all",
            "custom"
          ],
          "default": "hidden",
          "description": "Choose which annotation comments remain visible. Hidden comments still have a hover marker."
        },
        "agentContext.visibleTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Annotation types to display in custom mode (lowercase)."
        },
        "agentContext.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable annotation markers and concealment."
        }
      }
    }
  }
}
