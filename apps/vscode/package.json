{
  "name": "@agent-context/vscode",
  "displayName": "Agent Context",
  "description": "Visualize @agent-context annotations in VS Code.",
  "version": "0.1.0",
  "private": true,
  "publisher": "replace-me",
  "type": "commonjs",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": ["onStartupFinished"],
  "categories": ["Other"],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --outfile=dist/extension.js --external:vscode --sourcemap",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-context/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.25.9"
  }
}
